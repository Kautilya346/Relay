# =================================================================
# JanSahayak Backend Configuration Template (Google Cloud Production)
# =================================================================

# 1. Google Gemini & Vertex AI Configuration
# Get API key at: https://aistudio.google.com/ or set GOOGLE_GENAI_USE_VERTEXAI=true for GCP Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GCP_LOCATION=us-central1

# 2. Google Cloud Platform (GCP) Live Services Configuration
# Set to 'true' to connect live to Google Cloud Firestore, Storage, and Pub/Sub
USE_LIVE_GCP=false
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json


# 3. Google Cloud Storage Bucket for Binary Photo Evidence
STORAGE_BUCKET_NAME=your-gcs-bucket-name

# 4. Google Cloud Firestore Settings
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=

# 5. Google Cloud Pub/Sub Topic Settings
PUBSUB_TOPIC_PREFIX=jansahayak

# 6. Official portal dispatch (leave unset until the authority provides a documented endpoint)
SWACHHATA_API_URL=
SWACHHATA_API_KEY=
AUTHORITY_HTTP_TIMEOUT_SECONDS=20
BROWSER_HEADLESS=false
BROWSER_NAVIGATION_TIMEOUT_MS=30000
# Override these selectors for the exact portal form in use.
BROWSER_DEPARTMENT_SELECTOR=select[name='department']
BROWSER_DESCRIPTION_SELECTOR=textarea[name='description']
BROWSER_LATITUDE_SELECTOR=input[name='latitude']
BROWSER_LONGITUDE_SELECTOR=input[name='longitude']
BROWSER_EVIDENCE_SELECTOR=textarea[name='evidence']
BROWSER_SUBMIT_SELECTOR=button[type='submit']
BROWSER_RECEIPT_PATTERN=(?:registration|reference|acknowledg(?:e)?ment)[^A-Z0-9]*([A-Z0-9][A-Z0-9/-]{4,})

# 7. Server & Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
